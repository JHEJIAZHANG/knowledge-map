# systemd 服务：开机自动启动桥接服务，挂掉会自己重开
[Unit]
Description=Knowledge Map real terminal bridge
After=docker.service
Requires=docker.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/km-term
ExecStart=/usr/bin/python3 /home/ubuntu/km-term/km-bridge.py serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
